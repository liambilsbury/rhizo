# RHIZO_* settings androidd.service reads

# where Android's SELinux policy loads: namespace or host
RHIZO_SELINUX_MODE=namespace

# boot the sandbox with SELinux permissive
#RHIZO_PERMISSIVE=1

# compose the covering layer with CLIENT composition
#RHIZO_COMPOSER_DEVICE=0

# log the gralloc mapper verbosely
#RHIZO_MAPPER_VERBOSE=1

# skip the framebuffer resize
#RHIZO_NO_RESIZE=1

# make an SELinux domain permissive
#RHIZO_DEBUG_PERMISSIVE_DOMAIN=

# stop each boot after /data mounts, before Android starts
#RHIZO_FAULT_NO_READY=1

# the render node Android uses
#RHIZO_RENDER_NODE=/dev/dri/by-path/pci-0000:03:00.0-render
