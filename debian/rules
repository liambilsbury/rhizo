%:
	dh $@

# disable the autotools passes
override_dh_update_autotools_config:

override_dh_autoreconf:

# skip the repository tests
override_dh_auto_test:

# write debian/rhizo.postrm with the embedded teardown
override_dh_installdeb:
	python3 debian/embed-teardown.py --write
	dh_installdeb

BOOT_ONLY_UNITS := androidd.service rhizo-prepare.service rhizo-policy.service \
                   rhizo-update-begin.service rhizo-update-confirm.service rhizo-selinux-mode.service \
                   rhizo-host-labels.service
PROFILE_STATE_UNITS := rhizo-server-idle.service
override_dh_installsystemd:
	dh_installsystemd --no-start --no-stop-on-upgrade $(BOOT_ONLY_UNITS)
	dh_installsystemd --no-enable $(PROFILE_STATE_UNITS)
	dh_installsystemd $(addprefix -X,$(BOOT_ONLY_UNITS) $(PROFILE_STATE_UNITS))

override_dh_clean:
	dh_clean -d
	rm -rf debian/.debhelper debian/files debian/debhelper-build-stamp \
	       debian/*.substvars debian/*.debhelper debian/*.debhelper.log debian/rhizo.postrm

print-ship-set:
	@printf '%s\n' $(REQUIRED_DIRS) $(REQUIRED_FILES)

override_dh_auto_build:
	@missing=""; \
	for d in $(REQUIRED_DIRS); do [ -d "$$d" ] || missing="$$missing $$d"; done; \
	for f in $(REQUIRED_FILES); do [ -s "$$f" ] || missing="$$missing $$f"; done; \
	if [ -n "$$missing" ]; then \
	  echo "rhizo: cannot build, these staged artifacts are missing or empty:" >&2; \
	  for m in $$missing; do echo "  $$m" >&2; done; \
	  echo "run make all first" >&2; exit 1; \
	fi
	@for d in $(GPU_DRIVER_DIR) $(if $(filter 1,$(SHIP_32BIT_DRIVER)),var/share/gpu_driver_32) \
	          $(if $(filter 1,$(SHIP_SOFTWARE_DRIVER)),var/share/gpu_driver_software); do \
	  extra=""; \
	  for f in $$(cd $$d && find . -type f | sed 's|^\./||' | sort); do \
	    case " $(GPU_DRIVER_FILES) " in *" $$f "*) ;; *) extra="$$extra $$f" ;; esac; \
	  done; \
	  if [ -n "$$extra" ]; then \
	    echo "rhizo: $$d holds files this package does not ship:$$extra" >&2; exit 1; \
	  fi; \
	done

