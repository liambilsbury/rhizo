	dh_shlibdeps -prhizo -Xgfx_hal -Xgpu_driver -Xrhizo-probed \
	             -Xrhizo-wayland-probe -Xrhizo-keymint-service -Xrhizo-host-delay \
	             -- -l/usr/aarch64-linux-gnu/lib -l/usr/lib/aarch64-linux-gnu
else
	dh_shlibdeps -prhizo -Xgfx_hal -Xgpu_driver -Xrhizo-probed \
	             -Xrhizo-wayland-probe -Xrhizo-keymint-service -Xrhizo-host-delay
endif
