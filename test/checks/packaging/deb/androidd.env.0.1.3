# RHIZO_* knobs androidd.service reads as systemd KEY=value lines; uncomment one, restart androidd

# where Android's SELinux policy loads: namespace (its own namespace, Rhizo kernel) or host (host-wide)
RHIZO_SELINUX_MODE=namespace

# boot the sandbox with SELinux permissive instead of enforcing; never on a machine anyone else uses
#RHIZO_PERMISSIVE=1

# compose the one opaque covering layer with CLIENT instead of DEVICE composition
#RHIZO_COMPOSER_DEVICE=0

# log verbosely from the gralloc-mapper HAL's buffer-mapping path
#RHIZO_MAPPER_VERBOSE=1

# skip the framebuffer resize step, to isolate a display problem in the resize path
#RHIZO_NO_RESIZE=1

# leave an SELinux domain permissive, not the whole system, e.g. hal_graphics_composer_default
#RHIZO_DIAG_PERMISSIVE_DOMAIN=

# stop each boot after /data mounts and before Android starts; only gsi-update.sh's trial sets it
#RHIZO_FAULT_NO_READY=1

# the render node Android uses; unset, the supported GPU with most video memory; no GPU: rhizo gpu off
#RHIZO_RENDER_NODE=/dev/dri/by-path/pci-0000:03:00.0-render

# gsi-update.sh rewrites RHIZO_GSI, RHIZO_RELEASE and RHIZO_DATA_IMG here on every start
