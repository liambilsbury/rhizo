# Rhizo sandbox tuning knobs, read by androidd.service via its
# EnvironmentFile=-/etc/rhizo/androidd.env (systemd's own KEY=value format:
# blank lines and lines starting with # are ignored, everything else must be
# KEY=value with no shell quoting or expansion).
#
# This IS the packaged install's configuration channel for the RHIZO_* knobs
# test/vm/redeploy.sh forwards from the operator's shell on the rig --
# there is no redeploy.sh in the .deb, so editing this file is how a stranger
# reaches the same knobs. Every line below is commented out: the shipped
# default changes nothing, and uncommenting a takes effect on the next
# `systemctl restart androidd.service` (or the next boot), no rebuild needed.
#
# This file is a dpkg conffile (any file the package ships under /etc/ is
# treated as an automatically): an upgrade never touches a line you changed,
# and dpkg prompts on its own three-way-merge conflict if a package upgrade
# ever changes a default below that you also edited. It survives `rhizo
# uninstall`; only `rhizo uninstall --purge` removes it, with `/etc/rhizo` as
# a whole, same as hostfs.conf.
#
# The five knobs below are bisect dials, each a diagnostic and not a feature
# switch -- flip a back off once whatever you were bisecting is answered.

# Boots the sandbox with SELinux in permissive mode instead of enforcing.
# Never leave this set on a machine anyone else uses: every MAC denial that
# would have blocked something is only logged, not stopped.
#RHIZO_PERMISSIVE=1

# Forces the one opaque covering layer to CLIENT composition instead of
# DEVICE composition, trading the free path for the one that is easiest to
# reason about frame-by-frame when the display pipeline is suspect.
#RHIZO_COMPOSER_DEVICE=0

# Verbose logging from the gralloc-mapper HAL's buffer-mapping path.
#RHIZO_MAPPER_VERBOSE=1

# Skips the framebuffer resize step, for isolating whether a display problem
# is the resize path itself or something downstream of it.
#RHIZO_NO_RESIZE=1

# Boots with exactly one named SELinux domain left permissive instead of the
# whole system -- set this to the domain name you are bisecting, e.g.
# RHIZO_DIAG_PERMISSIVE_DOMAIN=hal_graphics_composer_default
#RHIZO_DIAG_PERMISSIVE_DOMAIN=

# Stops a boot after /data is mounted and before Android starts, and writes
# RHIZO_MARKER fault_no_ready=armed. It exists so a GSI update's trial can be
# made to genuinely fail without touching Google's image. Only
# test/system/lib/gsi-update-lib.sh sets it; leaving it set means the sandbox
# never comes up.
#RHIZO_FAULT_NO_READY=1

# RHIZO_GSI, RHIZO_RELEASE and RHIZO_DATA_IMG are written into this file by
# install/update/gsi-update.sh on every start, and rewritten on the next one.
# Set them by hand and `rhizo gsi` will overwrite them; change the release with
# `rhizo gsi update --release <label>` instead.
