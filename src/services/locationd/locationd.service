[Unit]
Description=Rhizo location host
Before=androidd.service
PartOf=androidd.service

[Service]
Type=simple
User=ubuntu
Group=rhizo
RuntimeDirectory=rhizo-location
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Restart=on-failure
RestartSec=1
Environment=PYTHONPATH=/usr/lib/rhizo
ExecCondition=/usr/lib/rhizo/tools/capability-allowed.sh devices.location
ExecStart=/usr/bin/python3 /usr/lib/rhizo/locationd/locationd.py --socket /run/rhizo-location/locationd
StandardOutput=append:/var/log/rhizo/rhizo-locationd.log
StandardError=append:/var/log/rhizo/rhizo-locationd.log
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
