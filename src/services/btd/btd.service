[Unit]
Description=Rhizo Bluetooth host
Before=androidd.service
PartOf=androidd.service
After=bluetooth.service

[Service]
Type=simple
RuntimeDirectory=rhizo-bt
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Restart=on-failure
RestartSec=1
ExecCondition=/usr/lib/rhizo/tools/capability-allowed.sh devices.bluetooth
ExecStart=/usr/bin/python3 /usr/lib/rhizo/btd/btd.py --socket /run/rhizo-bt/btd
StandardOutput=append:/var/log/rhizo/rhizo-btd.log
StandardError=append:/var/log/rhizo/rhizo-btd.log
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
RestrictAddressFamilies=AF_UNIX AF_BLUETOOTH
