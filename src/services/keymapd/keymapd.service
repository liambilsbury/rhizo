[Unit]
Description=Rhizo keyboard layout mapping
After=androidd.service
PartOf=androidd.service

[Service]
Type=simple
Environment=RHIZO_SANDBOX_ID=0
ExecStart=/usr/bin/python3 /usr/lib/rhizo/keymapd/keymapd.py
StandardOutput=append:/var/log/rhizo/rhizo-keymapd.log
StandardError=append:/var/log/rhizo/rhizo-keymapd.log
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/rhizo
