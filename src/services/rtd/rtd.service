[Unit]
Description=Rhizo real-time budget daemon
Before=androidd.service
PartOf=androidd.service
Wants=rhizo-selinux-mode.service
After=rhizo-selinux-mode.service

[Service]
Type=notify
Environment=PYTHONPATH=/usr/lib/rhizo
RuntimeDirectory=rhizo-rt rhizo-rtd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=78
ExecCondition=/usr/lib/rhizo/tools/capability-allowed.sh --any rt.budgets rt.contain
ExecStart=/usr/bin/python3 /usr/lib/rhizo/rtd/rtd.py \
    --socket /run/rhizo-rt/rtd --status-path /run/rhizo-rtd/status.json
StandardOutput=append:/var/log/rhizo/rhizo-rtd.log
StandardError=append:/var/log/rhizo/rhizo-rtd.log
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
