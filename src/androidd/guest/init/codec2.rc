# @RHIZO_SUBST early_init_restorecon

service vendor.rhizo-codec2 /vendor/bin/hw/rhizo-codec2-service
    interface aidl android.hardware.media.c2.IComponentStore/default
    class hal
    user mediacodec
    group camera mediadrm drmrpc
    ioprio rt 4
    task_profiles ProcessCapacityHigh
    stdio_to_kmsg
