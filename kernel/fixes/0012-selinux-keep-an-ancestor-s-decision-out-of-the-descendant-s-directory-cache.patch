diff --git a/security/selinux/avc.c b/security/selinux/avc.c
index fe09ce623..e93135d94 100644
--- a/security/selinux/avc.c
+++ b/security/selinux/avc.c
@@ -1549,17 +1549,23 @@ int cred_tsid_has_perm(const struct cred *cred, u32 tsid, u16 tclass,
  * @tclass: target security class
  * @requested: requested permissions, interpreted based on @tclass
  * @avd: access vector decisions
+ * @ad: audit data for an ancestor's denial
+ * @ancestors_allowed: the permissions every enforcing ancestor allows
  *
  * Check permissions between a cred @cred and a target SID @tsid for
  * @cred's namespace and all ancestors to determine whether the
- * @requested permissions are granted.
+ * @requested permissions are granted. @avd holds @cred's own namespace's
+ * decision; an ancestor that denies audits its denial itself and, when it
+ * enforces, sets AVD_FLAGS_UNCACHED.
  * Return %0 if all @requested permissions are granted, -%EACCES if any
  * permissions are denied, or another -errno upon other errors.
  * DO NOT USE when checking permissions between two creds (or tasks);
  * use cred_other_has_perm() or cred_task_has_perm() instead.
  */
 int cred_tsid_has_perm_noaudit(const struct cred *cred, u32 tsid, u16 tclass,
-			       u32 requested, struct av_decision *avd)
+			       u32 requested, struct av_decision *avd,
+			       struct common_audit_data *ad,
+			       u32 *ancestors_allowed)
 {
 	struct cred_security_struct *crsec;
 	struct selinux_state *state;
@@ -1567,14 +1573,19 @@ int cred_tsid_has_perm_noaudit(const struct cred *cred, u32 tsid, u16 tclass,
 	u32 ssid;
 	int rc;
 
+	*ancestors_allowed = ~0U;
 	crsec = selinux_cred(cred);
 	ssid = crsec->sid;
 	state = crsec->state;
 
 	rc = avc_has_perm_noaudit(state, ssid, tsid, tclass,
 				requested, 0, avd);
-	if (rc)
+	if (rc) {
+		/* no ancestor decided, so a cached entry may allow nothing below them */
+		if (crsec->parent_cred)
+			*ancestors_allowed = 0;
 		return rc;
+	}
 
 	cred = crsec->parent_cred;
 	while (cred) {
@@ -1587,10 +1598,22 @@ int cred_tsid_has_perm_noaudit(const struct cred *cred, u32 tsid, u16 tclass,
 
 		/* skip the all-allowed decision of an ancestor with no policy */
 		if (selinux_initialized(state)) {
-			avd->allowed &= tmp_avd.allowed;
+			/* the cache's permissive shortcut must not skip this namespace */
+			avd->flags &= ~AVD_FLAGS_NEVERAUDIT;
 			avd->auditallow |= tmp_avd.auditallow;
-			avd->auditdeny |= tmp_avd.auditdeny & ~tmp_avd.allowed;
-			avd->flags &= tmp_avd.flags;
+			/* an ancestor that would deny this subject bounds what may be cached */
+			if (enforcing_enabled(state) &&
+			    !(tmp_avd.flags & AVD_FLAGS_PERMISSIVE))
+				*ancestors_allowed &= tmp_avd.allowed;
+			/* a denying ancestor audits itself; only an enforced denial fails */
+			if (requested & ~tmp_avd.allowed) {
+				avc_audit(state, ssid, tsid, tclass, requested,
+					  &tmp_avd, rc, ad);
+				if (rc) {
+					avd->flags |= AVD_FLAGS_UNCACHED;
+					return rc;
+				}
+			}
 		}
 
 		if (rc)
diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
index 9fa03e8d6..64814fc7c 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -3803,7 +3803,7 @@ static int selinux_inode_permission(struct inode *inode, int requested)
 	struct task_security_struct *tsec;
 	struct inode_security_struct *isec;
 	struct avdc_entry *avdc;
-	int rc, rc2;
+	int rc, rc2, arc = 0;
 	u32 audited, denied;
 
 	mask = requested & (MAY_READ|MAY_WRITE|MAY_EXEC|MAY_APPEND);
@@ -3822,6 +3822,10 @@ static int selinux_inode_permission(struct inode *inode, int requested)
 	perms = file_mask_to_av(inode->i_mode, mask);
 
 	rc = task_avdcache_search(tsec, isec, &avdc);
+	/* a denial with ancestors above is decided again in every namespace */
+	if (likely(!rc) && unlikely(perms & ~avdc->allowed) &&
+	    selinux_cred(current_cred())->parent_cred)
+		rc = -ENOENT;
 	if (likely(!rc)) {
 		/* Cache hit. */
 		audited = perms & avdc->audited;
@@ -3829,22 +3833,34 @@ static int selinux_inode_permission(struct inode *inode, int requested)
 		if (unlikely(denied && enforcing_enabled(current_selinux_state) &&
 			     !avdc->permissive))
 			rc = -EACCES;
+		arc = rc;
 	} else {
 		struct av_decision avd;
+		struct common_audit_data ad;
+		u32 ancestors_allowed;
 
 		/* Cache miss. */
+		ad.type = LSM_AUDIT_DATA_INODE;
+		ad.u.inode = inode;
 		rc = cred_tsid_has_perm_noaudit(current_cred(), isec->sid,
-						isec->sclass, perms, &avd);
-		audited = avc_audit_required(perms, &avd, rc,
-			(requested & MAY_ACCESS) ? FILE__AUDIT_ACCESS : 0,
-			&denied);
-		task_avdcache_update(tsec, isec, &avd, audited);
+						isec->sclass, perms, &avd, &ad,
+						&ancestors_allowed);
+		/* an enforcing ancestor's denial is audited by it and never cached */
+		arc = (avd.flags & AVD_FLAGS_UNCACHED) ? 0 : rc;
+		audited = avc_audit_required(perms, &avd, arc,
+					     (requested & MAY_ACCESS) ?
+					     FILE__AUDIT_ACCESS : 0,
+					     &denied);
+		if (!(avd.flags & AVD_FLAGS_UNCACHED)) {
+			avd.allowed &= ancestors_allowed;
+			task_avdcache_update(tsec, isec, &avd, audited);
+		}
 	}
 
 	if (likely(!audited))
 		return rc;
 
-	rc2 = audit_inode_permission(inode, perms, audited, denied, rc);
+	rc2 = audit_inode_permission(inode, perms, audited, denied, arc);
 	if (rc2)
 		return rc2;
 
