diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
index 4f0d022894d..f4b98db45b7 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -4042,7 +4042,8 @@ static int selinux_file_permission(struct file *file, int mask)
 
 	isec = inode_security(inode);
 	if (sid == fsec->sid && fsec->isid == isec->sid &&
-	    fsec->pseqno == avc_policy_seqno(current_selinux_state))
+	    fsec->pseqno == avc_policy_seqno(current_selinux_state) &&
+	    fsec->reset_generation == avc_reset_generation())
 		/* No change since file_open check. */
 		return 0;
 
@@ -4496,6 +4497,7 @@ static int selinux_file_open(struct file *file)
 	 */
 	fsec->isid = isec->sid;
 	fsec->pseqno = avc_policy_seqno(current_selinux_state);
+	fsec->reset_generation = avc_reset_generation();
 	/*
 	 * Since the inode label or policy seqno may have changed
 	 * between the selinux_inode_permission check and the saving
diff --git a/security/selinux/include/objsec.h b/security/selinux/include/objsec.h
index c0e7c6a7c26..0509e41c7b0 100644
--- a/security/selinux/include/objsec.h
+++ b/security/selinux/include/objsec.h
@@ -81,6 +81,7 @@ struct file_security_struct {
 	u32 sid; /* SID of open file description */
 	u32 isid; /* SID of inode at the time of file open */
 	u32 pseqno; /* Policy seqno at the time of file open */
+	u32 reset_generation; /* AVC resets in all namespaces at file open */
 	const struct cred *cred; /* cred for file owner (for SIGIO) */
 };
 
