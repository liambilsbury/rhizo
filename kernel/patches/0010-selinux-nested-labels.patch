 #if CONFIG_SECURITY_SELINUX_SS_SID_CACHE_SIZE > 0
 	cache = &entry->ss_sid_cache;
 	for (i = cache->first; i >= 0 && i <= cache->last; i++) {
@@ -147,6 +228,10 @@ static int map_global_sid_to_ss(struct selinux_state *state, u32 sid,
 	if (rc)
 		return rc;
 
