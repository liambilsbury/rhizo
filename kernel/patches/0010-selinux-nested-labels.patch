+					  &ss_sid))
+			return selinux_ss_sid_to_context(state, ss_sid,
+							 scontext,
+							 scontext_len);
+	}
+
 	return global_sid_to_context(sid, scontext, scontext_len);
 }
 
@@ -251,6 +356,7 @@ int security_sid_to_context_valid(struct selinux_state *state, u32 sid,
 int security_sid_to_context_force(struct selinux_state *state, u32 sid,
 				  const char **scontext, u32 *scontext_len)
 {
+	sid = security_sid_for_state(sid, state);
 	// initial SID contexts have to be obtained from the policy, if initialized
 	if (sid <= SECINITSID_NUM && selinux_initialized(state))
 		return selinux_ss_sid_to_context_force(state, sid, scontext, scontext_len);
@@ -837,3 +943,117 @@ int security_netlbl_sid_to_secattr(struct selinux_state *state, u32 sid,
 	return 0;
 }
 #endif
+
+/* return the SID @sid records for @state, else its primary, else @sid itself */
+u32 security_sid_for_state(u32 sid, const struct selinux_state *state)
+{
+	struct sidtab_entry *entry;
+	u32 rec = 0;
+
+	if (sid <= SECINITSID_NUM)
+		return sid;
+	rcu_read_lock();
+	entry = sidtab_search_entry_force(&global_sidtab, sid);
+	if (entry && context_has_records(&entry->context)) {
+		if (state)
+			rec = context_record(&entry->context, state->id);
+		if (!rec)
+			rec = context_record(&entry->context, 0);
+	}
+	rcu_read_unlock();
+	return rec ? rec : sid;
+}
+
+/* return the SID of @sid's primary, without records */
+u32 security_sid_primary(u32 sid)
+{
+	return security_sid_for_state(sid, NULL);
+}
+
+/* return whether @state's policy defines @sid's context */
+bool security_sid_defined(struct selinux_state *state, u32 sid)
+{
+	const char *scontext;
+	u32 len, ss_sid;
+
+	sid = security_sid_for_state(sid, state);
+	if (sid <= SECINITSID_NUM || !selinux_initialized(state))
+		return true;
+	if (global_sid_to_context(sid, &scontext, &len))
+		return true;
+	return !selinux_ss_context_to_sid(state, scontext, len, &ss_sid,
+					  GFP_ATOMIC);
+}
+
+/* return in @out_sid @sid's primary with a record per pair of @ids and @sids */
+int security_sid_with_records(u32 sid, const u64 *ids, const u32 *sids,
+			      int n, u32 *out_sid)
+{
+	u8 order[SELINUX_RECORDS_MAX + 1];
+	struct context ctx = {};
+	const char *primary;
+	u32 primary_len, len;
+	char *str;
+	int i, j, rc;
+
+	sid = security_sid_primary(sid);
+	*out_sid = sid;
+	if (!n)
+		return 0;
+	if (n > SELINUX_RECORDS_MAX + 1)
+		return -EINVAL;
+	/* one order per set of records, so one set is one SID */
+	for (i = 0; i < n; i++)
+		order[i] = i;
+	for (i = 1; i < n; i++)
+		for (j = i; j > 0 && ids[order[j - 1]] > ids[order[j]]; j--)
+			swap(order[j - 1], order[j]);
+	rc = global_sid_to_context(sid, &primary, &primary_len);
+	if (rc)
+		return rc;
+	len = primary_len + (n + 1) * 34 + 1;
+	str = kmalloc(len, GFP_ATOMIC);
+	if (!str)
+		return -ENOMEM;
+	memcpy(str, primary, primary_len);
+	ctx.len = primary_len;
+	ctx.len += scnprintf(str + ctx.len, len - ctx.len, "%c0:%u",
+			     SELINUX_RECORD_MARK, sid);
+	for (i = 0; i < n; i++)
+		ctx.len += scnprintf(str + ctx.len, len - ctx.len, "%c%llu:%u",
+				     SELINUX_RECORD_MARK,
+				     (unsigned long long)ids[order[i]],
+				     security_sid_for_state(sids[order[i]], NULL));
+	str[ctx.len++] = '\0';
+	ctx.str = str;
+retry:
+	rcu_read_lock();
+	rc = sidtab_context_ss_to_sid(&global_sidtab, &ctx, NULL, 0, out_sid);
+	if (rc == -ESTALE) {
+		rcu_read_unlock();
+		goto retry;
+	}
+	rcu_read_unlock();
+	kfree(str);
+	if (rc)
+		*out_sid = sid;
+	return rc;
+}
+
+/* return in @out_sid @sid's primary with the ancestor records of @from */
+int security_sid_with_records_of(u32 sid, u32 from, u32 *out_sid)
+{
+	u64 ids[SELINUX_RECORDS_MAX];
+	u32 sids[SELINUX_RECORDS_MAX];
+	struct sidtab_entry *entry;
+	int n = 0;
+
+	rcu_read_lock();
+	entry = sidtab_search_entry_force(&global_sidtab, from);
+	if (from > SECINITSID_NUM && entry &&
+	    context_has_records(&entry->context))
+		n = context_records(&entry->context, 0, ids, sids,
+				    SELINUX_RECORDS_MAX);
+	rcu_read_unlock();
+	return security_sid_with_records(sid, ids, sids, n, out_sid);
+}
diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
index 706277dfd..99a2a54e5 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -555,6 +555,199 @@ static int cred_obj_sb_associate(const struct cred *cred, u32 ssid,
 	return 0;
 }
 
+/* return the SID one namespace level gives an object made by the task at that level */
+typedef u32 (*level_sid_fn)(const struct cred_security_struct *lvl,
+			    const void *arg);
+
+/* return @sid with a record of @fn's SID for each namespace above @crsec's, or unlabeled */
+static u32 sid_with_levels(const struct cred_security_struct *crsec, u32 sid,
+			   level_sid_fn fn, const void *arg)
+{
+	u64 ids[SELINUX_RECORDS_MAX];
+	u32 sids[SELINUX_RECORDS_MAX];
+	int n = 0;
+	u32 out;
+
+	sid = security_sid_primary(sid);
+	while (crsec->parent_cred) {
+		if (n == SELINUX_RECORDS_MAX)
+			return SECINITSID_UNLABELED;
+		crsec = selinux_cred(crsec->parent_cred);
+		ids[n] = crsec->state->id;
+		/* a namespace with no policy yet gets no label chosen below it */
+		if (!selinux_initialized(crsec->state))
+			sids[n++] = SECINITSID_UNLABELED;
+		else
+			sids[n++] = security_sid_for_state(fn(crsec, arg),
+							   crsec->state);
+	}
+	if (security_sid_with_records(sid, ids, sids, n, &out))
+		return SECINITSID_UNLABELED;
+	return out;
+}
+
+/* return the task's own SID at a level */
+static u32 level_task_sid(const struct cred_security_struct *lvl,
+			  const void *arg)
+{
+	return lvl->sid;
+}
+
+struct level_trans_arg {
+	u32 tsid; /* target, as each level sees it */
+	u16 tclass;
+	const struct qstr *name;
+	struct super_block *sb; /* the new inode's superblock, or NULL */
+};
+
+/* return a level's transition from the task's SID there to the target as it sees it */
+static u32 level_transition_sid(const struct cred_security_struct *lvl,
+				const void *varg)
+{
+	const struct level_trans_arg *arg = varg;
+	u32 tsid = arg->tsid ? arg->tsid : lvl->sid;
+	u32 out;
+
+	/* a parent this level has not labelled yet: its own label of the superblock */
+	if (arg->sb && security_sid_for_state(tsid, lvl->state) <= SECINITSID_NUM)
+		tsid = sb_sid_for_state(lvl->state, arg->sb);
+
+	if (security_transition_sid(lvl->state, lvl->sid, tsid, arg->tclass,
+				    arg->name, &out))
+		return lvl->sid;
+	return out;
+}
+
+/* return a level's unchanged view of the object's previous SID */
+static u32 level_previous_sid(const struct cred_security_struct *lvl,
+			      const void *arg)
+{
+	return security_sid_for_state(*(const u32 *)arg, lvl->state);
+}
+
+/* return the label of objects the current task makes, with a record per level */
+static u32 current_obj_sid(void)
+{
+	struct task_security_struct *tsec = selinux_task(current);
+	const struct cred_security_struct *crsec = selinux_cred(current_cred());
+	u32 gen = avc_reset_generation();
+	u32 sid;
+
+	if (tsec->obj_sid_of == crsec->sid &&
+	    tsec->obj_sid_ns == crsec->state->id &&
+	    tsec->obj_sid_gen == gen && tsec->obj_sid)
+		return tsec->obj_sid;
+	sid = sid_with_levels(crsec, crsec->sid, level_task_sid, NULL);
+	/* keep a failed build out of the cache */
+	if (sid != SECINITSID_UNLABELED) {
+		tsec->obj_sid = sid;
+		tsec->obj_sid_of = crsec->sid;
+		tsec->obj_sid_ns = crsec->state->id;
+		tsec->obj_sid_gen = gen;
+	}
+	return sid;
+}
+
+/* return whether @cred must be checked for use of @fsec's descriptor */
+static bool fd_use_needed(const struct cred *cred, u32 ssid,
+			  const struct file_security_struct *fsec)
+{
+	return ssid != fsec->sid ||
+	       selinux_cred(fsec->open_cred)->state != selinux_cred(cred)->state;
+}
+
+/* check that @cred may use a descriptor, each namespace with the opener's SID there */
+static int fd_use_has_perm(const struct cred *cred,
+			   const struct file_security_struct *fsec,
+			   struct common_audit_data *ad)
+{
+	const struct cred_security_struct *crsec, *osec;
+	u32 tsid;
+	int rc;
+
+	do {
+		crsec = selinux_cred(cred);
+		tsid = fsec->sid;
+		osec = selinux_cred(fsec->open_cred);
+		while (osec->state != crsec->state && osec->parent_cred)
+			osec = selinux_cred(osec->parent_cred);
+		if (osec->state == crsec->state)
+			tsid = osec->sid;
+		rc = avc_has_perm(crsec->state, crsec->sid, tsid, SECCLASS_FD,
+				  FD__USE, ad);
+		if (rc)
+			return rc;
+		cred = crsec->parent_cred;
+	} while (cred);
+
+	return 0;
+}
+
+/* return @sb's labelling behavior, or before its set-up, the nearest policy's for its type */
+static unsigned short sb_behavior_seen(const struct cred_security_struct *crsec,
+				       const struct super_block *sb)
+{
+	const struct superblock_security_struct *sbsec = selinux_superblock(sb);
+	unsigned short behavior;
+	u32 sid;
+
+	if (sbsec->flags & SE_SBINITIALIZED)
+		return sbsec->behavior;
+	while (!selinux_initialized(crsec->state) && crsec->parent_cred)
+		crsec = selinux_cred(crsec->parent_cred);
+	if (!selinux_initialized(crsec->state) ||
+	    security_fs_use(crsec->state, sb->s_type->name, &behavior, &sid))
+		return SECURITY_FS_USE_NONE;
+	return behavior;
+}
+
+/* return whether @sb keeps inode labels in memory, by transition, as @crsec sees it */
+static bool sb_labels_by_transition(const struct cred_security_struct *crsec,
+				    const struct super_block *sb)
+{
+	return !(selinux_superblock(sb)->flags & (CONTEXT_MNT | FSCONTEXT_MNT)) &&
+	       sb_behavior_seen(crsec, sb) == SECURITY_FS_USE_TRANS;
+}
+
+/* return @newsid with each level's unchanged view of an in-memory inode's @oldsid */
+static u32 relabel_sid(const struct inode *inode, u32 oldsid, u32 newsid)
+{
+	const struct cred_security_struct *crsec = selinux_cred(current_cred());
+
+	newsid = security_sid_primary(newsid);
+	if (!sb_labels_by_transition(crsec, inode->i_sb))
+		return newsid;
+	return sid_with_levels(crsec, newsid, level_previous_sid, &oldsid);
+}
+
+/* return @sid with each ancestor of @state's transition from @task_sid to its own label of @sb */
+static u32 sb_sid_with_ancestors(struct selinux_state *state,
+				 const struct super_block *sb, u32 sid,
+				 u32 task_sid, u16 sclass)
+{
+	u64 ids[SELINUX_RECORDS_MAX];
+	u32 sids[SELINUX_RECORDS_MAX];
+	int n = 0;
+	u32 out;
+
+	for (state = state->parent; state; state = state->parent) {
+		if (n == SELINUX_RECORDS_MAX)
+			return SECINITSID_UNLABELED;
+		if (!selinux_initialized(state))
+			sids[n] = SECINITSID_UNLABELED;
+		else if (security_transition_sid(state, task_sid,
+						 sb_sid_for_state(state, sb),
+						 sclass, NULL, &sids[n]))
+			sids[n] = sb_sid_for_state(state, sb);
+		ids[n++] = state->id;
+	}
+	if (!n)
+		return sid;
+	if (security_sid_with_records(sid, ids, sids, n, &out))
+		return SECINITSID_UNLABELED;
+	return out;
+}
