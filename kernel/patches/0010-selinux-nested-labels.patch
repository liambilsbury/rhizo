--- a/security/selinux/global_sidtab.c
+++ b/security/selinux/global_sidtab.c
@@ -40,6 +40,69 @@ int global_sidtab_init(void)
 	return 0;
 }
 
+/* return whether @ctx has namespace records */
+static bool context_has_records(const struct context *ctx)
+{
+	return ctx->str && ctx->len > strlen(ctx->str) + 1;
+}
+
+/* copy @ctx's records except 0 and @skip into @ids and @sids, up to @max; return the count */
+static int context_records(const struct context *ctx, u64 skip, u64 *ids,
+			   u32 *sids, int max)
+{
+	const char *p = ctx->str + strlen(ctx->str) + 1;
+	const char *end = ctx->str + ctx->len - 1;
+	unsigned long long rid;
+	unsigned int rsid;
+	int n = 0;
+
+	while (p && p < end && n < max) {
+		if (sscanf(p + 1, "%llu:%u", &rid, &rsid) == 2 && rid &&
+		    rid != skip) {
+			ids[n] = rid;
+			sids[n++] = rsid;
+		}
+		p = memchr(p + 1, SELINUX_RECORD_MARK, end - p - 1);
+	}
+	return n;
+}
+
+/* return the SID @ctx records for the namespace with @id, or 0; id 0 holds the primary */
+static u32 context_record(const struct context *ctx, u64 id)
+{
+	const char *p = ctx->str + strlen(ctx->str) + 1;
+	const char *end = ctx->str + ctx->len - 1;
+	unsigned long long rid;
+	unsigned int rsid;
+
+	while (p && p < end) {
+		if (sscanf(p + 1, "%llu:%u", &rid, &rsid) == 2 && rid == id)
+			return rsid;
+		p = memchr(p + 1, SELINUX_RECORD_MARK, end - p - 1);
+	}
+	return 0;
+}
+
+/* return whether @scontext names a subject: a role other than object_r */
+static bool context_is_subject(const char *scontext)
+{
+	const char *role = strchr(scontext, ':');
+
+	return role && strncmp(role + 1, "object_r:", 9);
+}
+
+/* map a subject context that @state, below an ancestor, cannot define to its kernel SID */
+static bool outside_subject_to_ss(struct selinux_state *state,
+				  const char *scontext, u32 len, u32 *ss_sid)
+{
+	if (!state->parent || !context_is_subject(scontext) ||
+	    !selinux_ss_context_to_sid(state, scontext, len, ss_sid,
+				       GFP_ATOMIC))
+		return false;
+	*ss_sid = SECINITSID_KERNEL;
+	return true;
+}
+
 static int global_sid_to_context(u32 sid, const char **scontext, u32 *scontext_len)
 {
 	struct context *ctx;
@@ -53,7 +116,9 @@ static int global_sid_to_context(u32 sid, const char **scontext, u32 *scontext_l
 		*scontext_len = 0;
