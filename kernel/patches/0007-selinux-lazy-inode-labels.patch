diff --git a/security/selinux/hooks.c b/security/selinux/hooks.c
index f4b98db45b7..2ae1a9b1333 100644
--- a/security/selinux/hooks.c
+++ b/security/selinux/hooks.c
@@ -1524,7 +1524,7 @@ static int inode_doinit_with_dentry(struct inode *inode, struct dentry *opt_dent
 		state = state->parent;
 
 	sbsec = selinux_superblock(sb);
-	if (!state || !(sbsec->flags & SE_SBINITIALIZED)) {
+	if (!(sbsec->flags & SE_SBINITIALIZED)) {
 		/* Defer initialization until selinux_complete_init,
 		   after the initial policy is loaded and the security
 		   server is ready to handle calls. */
@@ -1535,6 +1535,10 @@ static int inode_doinit_with_dentry(struct inode *inode, struct dentry *opt_dent
 		goto out_unlock;
 	}
 
+	/* defer the label to its first use in a namespace with a policy */
+	if (!state)
+		goto out_unlock;
+
 	sclass = isec->sclass;
 	task_sid = isec->task_sid;
 	sid = isec->sid;
@@ -3124,8 +3128,15 @@ static int selinux_inode_init_security(struct inode *inode, struct inode *dir,
 	if (rc)
 		return rc;
 
-	/* Possibly defer initialization to selinux_complete_init. */
-	if (sbsec->flags & SE_SBINITIALIZED) {
+	/*
+	 * Possibly defer initialization to selinux_complete_init, or, on a
+	 * filesystem with stored labels, to the first use in a namespace
+	 * with a policy.
+	 */
+	if ((sbsec->flags & SE_SBINITIALIZED) &&
+	    (selinux_initialized(current_selinux_state) ||
+	     (sbsec->behavior != SECURITY_FS_USE_XATTR &&
+	      sbsec->behavior != SECURITY_FS_USE_NATIVE))) {
 		struct inode_security_struct *isec = selinux_inode(inode);
 		isec->sclass = newsclass;
 		isec->sid = newsid;
@@ -3663,6 +3674,24 @@ static int selinux_inode_remove_acl(struct mnt_idmap *idmap,
 	return dentry_has_perm(current_cred(), dentry, FILE__SETATTR);
 }
 
+/* mark the label of an inode on a filesystem with stored labels invalid */
+static void inode_invalidate_stored_label(struct dentry *dentry)
+{
+	struct inode *inode = d_backing_inode(dentry);
+	struct superblock_security_struct *sbsec = selinux_superblock(inode->i_sb);
+	struct inode_security_struct *isec;
+
+	if (sbsec->behavior == SECURITY_FS_USE_TRANS ||
+	    sbsec->behavior == SECURITY_FS_USE_TASK ||
+	    sbsec->behavior == SECURITY_FS_USE_MNTPOINT)
+		return;
+
+	isec = backing_inode_security_novalidate(dentry);
+	spin_lock(&isec->lock);
+	isec->initialized = LABEL_INVALID;
+	spin_unlock(&isec->lock);
+}
+
 static void selinux_inode_post_setxattr(struct dentry *dentry, const char *name,
 					const void *value, size_t size,
 					int flags)
@@ -3679,10 +3708,11 @@ static void selinux_inode_post_setxattr(struct dentry *dentry, const char *name,
 
 	if (!selinux_initialized(current_selinux_state)) {
 		/* If we haven't even been initialized, then we can't validate
-		 * against a policy, so leave the label as invalid. It may
+		 * against a policy, so mark a stored label as invalid. It may
 		 * resolve to a valid label on the next revalidation try if
 		 * we've since initialized.
 		 */
+		inode_invalidate_stored_label(dentry);
 		return;
 	}
 
@@ -3732,6 +3762,17 @@ static int selinux_inode_removexattr(struct mnt_idmap *idmap,
 	return -EACCES;
 }
 
+/* mark a stored label removed in a namespace with no policy invalid */
+static void selinux_inode_post_removexattr(struct dentry *dentry,
+					   const char *name)
+{
+	if (strcmp(name, XATTR_NAME_SELINUX) ||
+	    selinux_initialized(current_selinux_state))
+		return;
+
+	inode_invalidate_stored_label(dentry);
+}
+
 static int selinux_inode_file_setattr(struct dentry *dentry,
 				      struct file_kattr *fa)
 {
@@ -3863,6 +3904,16 @@ static int selinux_inode_setsecurity(struct inode *inode, const char *name,
 	if (!value || !size)
 		return -EACCES;
 
+	if (!selinux_initialized(current_selinux_state) &&
+	    selinux_superblock(inode->i_sb)->behavior ==
+	    SECURITY_FS_USE_NATIVE) {
+		/* defer the label to a namespace with a policy */
+		spin_lock(&isec->lock);
+		isec->initialized = LABEL_INVALID;
+		spin_unlock(&isec->lock);
+		return 0;
+	}
+
 	rc = security_context_to_sid(current_selinux_state, value, size, &newsid,
 				     GFP_KERNEL);
 	if (rc)
@@ -3943,6 +3994,10 @@ static int selinux_kernfs_init_security(struct kernfs_node *kn_dir,
 	char *context;
 	const char *context2;
 
+	/* skip the label of a node created in a namespace with no policy */
+	if (!selinux_initialized(current_selinux_state))
+		return 0;
+
 	rc = kernfs_xattr_get(kn_dir, XATTR_NAME_SELINUX, NULL, 0);
 	if (rc == -ENODATA)
 		return 0;
@@ -7997,6 +8052,7 @@ static struct security_hook_list selinux_hooks[] __ro_after_init = {
 	LSM_HOOK_INIT(inode_getxattr, selinux_inode_getxattr),
 	LSM_HOOK_INIT(inode_listxattr, selinux_inode_listxattr),
 	LSM_HOOK_INIT(inode_removexattr, selinux_inode_removexattr),
+	LSM_HOOK_INIT(inode_post_removexattr, selinux_inode_post_removexattr),
 	LSM_HOOK_INIT(inode_file_getattr, selinux_inode_file_getattr),
 	LSM_HOOK_INIT(inode_file_setattr, selinux_inode_file_setattr),
 	LSM_HOOK_INIT(inode_set_acl, selinux_inode_set_acl),
