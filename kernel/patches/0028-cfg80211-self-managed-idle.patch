diff --git a/net/wireless/sme.c b/net/wireless/sme.c
index 86e2ccaa678..ac8fdd34df1 100644
--- a/net/wireless/sme.c
+++ b/net/wireless/sme.c
@@ -688,12 +688,16 @@ static bool cfg80211_is_all_idle(void)
 	 * Also if there is any other active beaconing interface we
 	 * need not issue a disconnect hint and reset any info such
 	 * as chan dfs state, etc.
 	 */
 	for_each_rdev(rdev) {
+		bool self_managed = rdev->wiphy.regulatory_flags &
+				    REGULATORY_WIPHY_SELF_MANAGED;
+
 		guard(wiphy)(&rdev->wiphy);
 
 		list_for_each_entry(wdev, &rdev->wiphy.wdev_list, list) {
-			if (wdev->conn || wdev->connected ||
+			if ((!self_managed &&
+			     (wdev->conn || wdev->connected)) ||
 			    cfg80211_beaconing_iface_active(wdev))
 				is_all_idle = false;
 		}
@@ -1398,7 +1405,8 @@ void __cfg80211_disconnected(struct net_device *dev, const u8 *ie,
 	wdev->wext.connect.ssid_len = 0;
 #endif
 
-	schedule_work(&cfg80211_disconnect_work);
+	if (!(wdev->wiphy->regulatory_flags & REGULATORY_WIPHY_SELF_MANAGED))
+		schedule_work(&cfg80211_disconnect_work);
 
 	cfg80211_schedule_channels_check(wdev);
 }
