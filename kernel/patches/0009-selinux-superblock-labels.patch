+/* return the SID of superblock @sb in @state's own policy */
+static u32 sb_sid_for_state(struct selinux_state *state,
+			    const struct super_block *sb)
+{
+	struct superblock_security_struct *sbsec = selinux_superblock(sb);
+	unsigned short behavior;
+	u32 sid;
+	int rc;
+
+	if ((sbsec->flags & (CONTEXT_MNT | FSCONTEXT_MNT)) ||
+	    (state == init_selinux_state && !(sbsec->flags & SE_SBNSLABEL)) ||
+	    !selinux_initialized(state))
+		return sbsec->sid;
+
+	if (sbsec->behavior == SECURITY_FS_USE_GENFS)
+		rc = security_genfs_sid(state, sb->s_type->name, "/",
+					SECCLASS_DIR, &sid);
+	else
+		rc = security_fs_use(state, sb->s_type->name, &behavior, &sid);
+	if (rc)
+		return sbsec->sid;
+	return sid;
+}
+
+/* check @cred's @perms on @sb in each namespace */
+static int cred_sb_has_perm(const struct cred *cred,
+			    const struct super_block *sb, u32 perms,
+			    struct common_audit_data *ad)
+{
+	struct superblock_security_struct *sbsec = selinux_superblock(sb);
+	const struct cred_security_struct *crsec = selinux_cred(cred);
+	int rc;
+
+	if (!crsec->parent_cred && !(sbsec->flags & SE_SBNSLABEL))
+		return cred_tsid_has_perm(cred, sbsec->sid, SECCLASS_FILESYSTEM,
+					  perms, ad);
+
+	do {
+		crsec = selinux_cred(cred);
+		rc = avc_has_perm(crsec->state, crsec->sid,
+				  sb_sid_for_state(crsec->state, sb),
+				  SECCLASS_FILESYSTEM, perms, ad);
+		if (rc)
+			return rc;
+		cred = crsec->parent_cred;
+	} while (cred);
+
+	return 0;
+}
+
+/* check that @ssid may be associated with @sb in each namespace */
+static int cred_obj_sb_associate(const struct cred *cred, u32 ssid,
+				 const struct super_block *sb,
+				 struct common_audit_data *ad)
+{
+	struct superblock_security_struct *sbsec = selinux_superblock(sb);
+	const struct cred_security_struct *crsec = selinux_cred(cred);
+	int rc;
+
+	if (!crsec->parent_cred && !(sbsec->flags & SE_SBNSLABEL))
+		return cred_obj_has_perm(cred, ssid, sbsec->sid,
+					 SECCLASS_FILESYSTEM,
+					 FILESYSTEM__ASSOCIATE, ad);
+
+	do {
+		crsec = selinux_cred(cred);
+		rc = avc_has_perm(crsec->state, ssid,
+				  sb_sid_for_state(crsec->state, sb),
+				  SECCLASS_FILESYSTEM, FILESYSTEM__ASSOCIATE,
+				  ad);
+		if (rc)
+			return rc;
+		cred = crsec->parent_cred;
+	} while (cred);
+
+	return 0;
+}
