+/* return @entry's SID in the namespace with @id */
+static u32 entry_ss_sid(struct sidtab_entry *entry, u64 id)
+{
+	unsigned int seq;
+	u32 ss_sid;
+#if CONFIG_SECURITY_SELINUX_SS_SID_CACHE_SIZE > 0
+	int i;
+#endif
+
+	do {
+		seq = read_seqcount_begin(&entry->ss_seq);
+		ss_sid = entry->ns == id ? entry->ss_sid : 0;
+#if CONFIG_SECURITY_SELINUX_SS_SID_CACHE_SIZE > 0
+		for (i = 0; !ss_sid && i < ARRAY_SIZE(entry->ss_sid_cache.ns);
+		     i++)
+			if (entry->ss_sid_cache.ns[i] == id)
+				ss_sid = entry->ss_sid_cache.ss_sid[i];
+#endif
+	} while (read_seqcount_retry(&entry->ss_seq, seq));
+	return ss_sid;
+}
+
+#if CONFIG_SECURITY_SELINUX_SS_SID_CACHE_SIZE > 0
+/* cache @entry's SID for the namespace with @id */
+static void entry_cache_ss_sid(struct sidtab_entry *entry, u64 id, u32 ss_sid)
+{
+	struct sidtab_ss_sid_cache *cache = &entry->ss_sid_cache;
+	int i, n = ARRAY_SIZE(cache->ns);
+
+	/* find the namespace's slot or a free slot */
+	for (i = 0; i < n && cache->ns[i] != id; i++)
+		;
+	if (i == n)
+		for (i = 0; i < n && cache->ns[i]; i++)
+			;
+	if (i == n)
+		i = (u32)id % n;
+	write_seqcount_begin(&entry->ss_seq);
+	cache->ns[i] = id;
+	cache->ss_sid[i] = ss_sid;
+	write_seqcount_end(&entry->ss_seq);
+}
+#endif
