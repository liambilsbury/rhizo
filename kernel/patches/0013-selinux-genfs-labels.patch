index be97f81bf..01a1b3e15 100644
--- a/security/selinux/global_sidtab.c
+++ b/security/selinux/global_sidtab.c
@@ -1060,3 +1060,39 @@ int security_sid_with_records_of(u32 sid, u32 from, u32 *out_sid)
 	rcu_read_unlock();
 	return security_sid_with_records(sid, ids, sids, n, out_sid);
 }
+
+/* return in @out_sid @sid with its record for the namespace @id set to @rec */
+int security_sid_add_record(u32 sid, u64 id, u32 rec, u32 *out_sid)
+{
+	u64 ids[SELINUX_RECORDS_MAX + 1];
+	u32 sids[SELINUX_RECORDS_MAX + 1];
+	struct sidtab_entry *entry;
+	int n = 0;
+
+	rcu_read_lock();
+	entry = sidtab_search_entry_force(&global_sidtab, sid);
+	if (sid > SECINITSID_NUM && entry &&
+	    context_has_records(&entry->context))
+		n = context_records(&entry->context, id, ids, sids,
+				    SELINUX_RECORDS_MAX);
+	rcu_read_unlock();
+	ids[n] = id;
+	sids[n++] = rec;
+	return security_sid_with_records(sid, ids, sids, n, out_sid);
+}
+
+/* return whether @sid holds a record for the namespace with @id */
+bool security_sid_has_record(u32 sid, u64 id)
+{
+	struct sidtab_entry *entry;
+	bool found = false;
+
+	if (sid <= SECINITSID_NUM)
+		return false;
+	rcu_read_lock();
+	entry = sidtab_search_entry_force(&global_sidtab, sid);
+	if (entry && context_has_records(&entry->context))
+		found = context_record(&entry->context, id) != 0;
+	rcu_read_unlock();
+	return found;
+}
