+/**
+ * kernfs_walk_supers - call a function on each super_block of a hierarchy
+ * @kn: a node of the hierarchy
+ * @fn: the function to call with each super_block of @kn's hierarchy
+ * @arg: the argument to pass to @fn
+ *
+ * @fn runs with the hierarchy's super_block list read-locked and must not
+ * add or remove nodes.  The walk stops at the first nonzero return.
+ *
+ * Return: the first nonzero return of @fn, or 0.
+ */
+int kernfs_walk_supers(struct kernfs_node *kn,
+		       int (*fn)(struct super_block *sb, void *arg),
+		       void *arg)
+{
+	struct kernfs_root *root = kernfs_root(kn);
+	struct kernfs_super_info *info;
+	int rc = 0;
+
+	down_read(&root->kernfs_supers_rwsem);
+	list_for_each_entry(info, &root->supers, node) {
+		rc = fn(info->sb, arg);
+		if (rc)
+			break;
+	}
+	up_read(&root->kernfs_supers_rwsem);
+	return rc;
+}
+
