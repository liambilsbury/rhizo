+	sid = READ_ONCE(isec->sid);
+	if (!label_ns || (READ_ONCE(isec->view_ns) == top->state->id &&
+			  READ_ONCE(isec->view_sid) == sid &&
+			  READ_ONCE(isec->view_gen) == gen))
+		return 0;
+	/* nothing to add unless a namespace other than the labeller has a policy */
+	for (crsec = top; crsec && !any; crsec = crsec->parent_cred ?
+			selinux_cred(crsec->parent_cred) : NULL)
+		any = crsec->state->id != label_ns &&
+		      selinux_initialized(crsec->state);
+	if (!any)
+		return 0;
+	if (!may_sleep)
+		return -ECHILD;
