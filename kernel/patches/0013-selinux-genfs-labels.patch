+/* give each namespace of the current cred its own label of a genfs inode another one labelled */
+static int inode_add_genfs_views(struct inode *inode, struct dentry *dentry,
+				 bool may_sleep)
+{
+	struct inode_security_struct *isec = selinux_inode(inode);
+	const struct cred_security_struct *top = selinux_cred(current_cred());
+	const struct cred_security_struct *crsec;
+	u64 label_ns = READ_ONCE(isec->label_ns);
+	u32 gen = avc_reset_generation();
+	struct dentry *found = NULL;
+	bool complete = true, any = false;
+	u32 sid, view, newsid;
