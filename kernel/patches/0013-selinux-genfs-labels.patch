+	if (!complete)
+		return 0;
+	spin_lock(&isec->lock);
+	if (isec->sid == sid) {
+		isec->view_sid = sid;
+		isec->view_ns = top->state->id;
+		isec->view_gen = gen;
+	}
+	spin_unlock(&isec->lock);
+	return 0;
