 	       sb_behavior_seen(crsec, sb) == SECURITY_FS_USE_TRANS;
 }
 
+/* return whether @state is a namespace below @ancestor */
+static bool state_is_below(const struct selinux_state *state,
+			   const struct selinux_state *ancestor)
+{
+	for (state = state ? state->parent : NULL; state; state = state->parent)
+		if (state == ancestor)
+			return true;
+	return false;
+}
+
+/* return the namespace below @state that set up @sb, or NULL */
+static struct selinux_state *
+sb_namespace_below(const struct super_block *sb,
+		   const struct selinux_state *state)
+{
+	struct selinux_state *ns = READ_ONCE(selinux_superblock(sb)->ns_state);
+
+	return ns && state_is_below(ns, state) ? ns : NULL;
+}
+
+/* return @sid with each namespace's transition from below @crsec's down to @dir's sb owner */
+static u32 sid_with_sb_namespace(const struct cred_security_struct *crsec,
+				 struct inode *dir, u32 dsid, u32 sid,
+				 u16 tclass, const struct qstr *name)
+{
+	struct selinux_state *ns = sb_namespace_below(dir->i_sb, crsec->state);
+	u32 tsid, view, out;
+
+	for (; ns && ns != crsec->state; ns = ns->parent) {
+		if (!selinux_initialized(ns))
+			continue;
+		tsid = dsid;
+		/* a parent this namespace has not labelled: its own label of the superblock */
+		if (security_sid_for_state(tsid, ns) <= SECINITSID_NUM)
+			tsid = sb_sid_for_state(ns, dir->i_sb);
+		if (security_transition_sid(ns, crsec->sid, tsid, tclass, name,
+					    &view) ||
+		    security_sid_add_record(sid, ns->id, view, &out))
+			continue;
+		sid = out;
+	}
+	return sid;
+}
+
 /* return @newsid with each level's unchanged view of an in-memory inode's @oldsid */
 static u32 relabel_sid(const struct inode *inode, u32 oldsid, u32 newsid)
 {
 	const struct cred_security_struct *crsec = selinux_cred(current_cred());
+	const struct selinux_state *ns;
+	u32 out;
 
 	newsid = security_sid_primary(newsid);
 	if (!sb_labels_by_transition(crsec, inode->i_sb))
 		return newsid;
-	return sid_with_levels(crsec, newsid, level_previous_sid, &oldsid);
+	newsid = sid_with_levels(crsec, newsid, level_previous_sid, &oldsid);
+	/* each namespace from here down to the superblock's owner keeps its view too */
+	for (ns = sb_namespace_below(inode->i_sb, crsec->state);
+	     ns && ns != crsec->state; ns = ns->parent)
+		if (selinux_initialized(ns) &&
+		    !security_sid_add_record(newsid, ns->id,
+					     security_sid_for_state(oldsid, ns),
+					     &out))
+			newsid = out;
+	return newsid;
 }
 
