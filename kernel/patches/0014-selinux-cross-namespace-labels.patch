+/* mark @sbsec as set up below init, owned by the current namespace unless the host deferred it */
+static void sb_set_ns_state(struct superblock_security_struct *sbsec)
+{
+	sbsec->flags |= SE_SBNSLABEL;
+	if (!(sbsec->flags & SE_SBINITNSDEFER) && !sbsec->ns_state)
+		WRITE_ONCE(sbsec->ns_state,
+			   get_selinux_state(current_selinux_state));
+}
