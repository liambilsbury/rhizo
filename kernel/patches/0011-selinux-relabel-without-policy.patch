+/* return the first namespace from @cred's up that has a policy, or NULL */
+static const struct cred_security_struct *
+cred_policy_level(const struct cred *cred)
+{
+	const struct cred_security_struct *crsec = selinux_cred(cred);
+
+	while (!selinux_initialized(crsec->state)) {
+		if (!crsec->parent_cred)
+			return NULL;
+		crsec = selinux_cred(crsec->parent_cred);
+	}
+	return crsec;
+}
+
+/* return whether a namespace above @cred's with a policy cannot define @sid */
+static bool ancestor_cannot_define(const struct cred *cred, u32 sid)
+{
+	const struct cred_security_struct *crsec = selinux_cred(cred);
+
+	while (crsec->parent_cred) {
+		crsec = selinux_cred(crsec->parent_cred);
+		if (selinux_initialized(crsec->state) &&
+		    !security_sid_defined(crsec->state, sid))
+			return true;
+	}
+	return false;
+}
+
+/* return whether the current namespace is below init and has no policy to validate a string */
+static bool unvalidated_in_namespace(void)
+{
+	const struct selinux_state *state = current_selinux_state;
+
+	return state->parent && !selinux_initialized(state);
+}
