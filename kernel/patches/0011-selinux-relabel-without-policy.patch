+/* check @perms on a socket in each namespace of the current cred that does not skip it */
+static int sock_cred_has_perm(u32 sid, u16 sclass, u32 perms, bool xperm,
+			      u8 driver, u8 xp, struct common_audit_data *ad)
+{
+	const struct cred *cred = current_cred();
+	const struct cred_security_struct *crsec;
+	int rc;
+
+	do {
+		crsec = selinux_cred(cred);
+		if (!sock_skip_has_perm(crsec->state, sid)) {
+			if (xperm)
+				rc = avc_has_extended_perms(crsec->state,
+							    crsec->sid, sid,
+							    sclass, perms,
+							    driver,
+							    AVC_EXT_NLMSG, xp,
+							    ad);
+			else
+				rc = avc_has_perm(crsec->state, crsec->sid,
+						  sid, sclass, perms, ad);
+			if (rc)
+				return rc;
+		}
+		cred = crsec->parent_cred;
+	} while (cred);
+
+	return 0;
+}
