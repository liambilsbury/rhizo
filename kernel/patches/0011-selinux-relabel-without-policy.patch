+/* log a context a caller without mac_admin may not set */
+static void audit_invalid_context(const char *op, const char *str,
+				  size_t size)
+{
+	struct audit_buffer *ab;
+
+	/* strip a nul only at the end; one inside the context is audited */
+	if (str && size && str[size - 1] == '\0')
+		size--;
+	if (!str)
+		size = 0;
+	ab = audit_log_start(audit_context(), GFP_ATOMIC, AUDIT_SELINUX_ERR);
+	if (!ab)
+		return;
+	audit_log_format(ab, "op=%s invalid_context=", op);
+	audit_log_n_untrustedstring(ab, str, size);
+	audit_log_end(ab);
+}
