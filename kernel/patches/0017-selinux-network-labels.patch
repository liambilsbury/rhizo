+/**
+ * selinux_state_policy_object_has_perm - Check a policy-labelled object per level
+ * @state: SELinux state of the subject
+ * @ssid: source security identifier in @state
+ * @object_sid: gives the SID a namespace's own policy gives the object
+ * @arg: the object, passed to @object_sid
+ * @tclass: target security class
+ * @requested: requested permissions, interpreted based on @tclass
+ * @ad: auxiliary audit data
+ *
+ * As selinux_state_has_perm(), but each namespace checks the object by the SID
+ * its own policy gives it, such as a port, node or interface label.
+ * Return %0 if all @requested permissions are granted, -%EACCES if any
+ * permissions are denied, or another -errno upon other errors.
+ */
+int selinux_state_policy_object_has_perm(struct selinux_state *state, u32 ssid,
+					 object_sid_fn object_sid,
+					 const void *arg, u16 tclass,
+					 u32 requested,
+					 struct common_audit_data *ad)
+{
+	u32 tsid;
+	int rc;
+
+	do {
+		rc = object_sid(state, arg, &tsid);
+		if (rc)
+			return rc;
+		rc = avc_has_perm(state, ssid, tsid, tclass, requested, ad);
+		if (rc)
+			return rc;
+
+		ssid = state->creator_sid;
+		state = state->parent;
+	} while (state);
+
+	return 0;
+}
+
+/**
+ * cred_policy_object_has_perm - Check a policy-labelled object per level
+ * @cred: subject credentials
+ * @ssid: source security identifier in @cred's namespace
+ * @object_sid: gives the SID a namespace's own policy gives the object
+ * @arg: the object, passed to @object_sid
+ * @tclass: target security class
+ * @requested: requested permissions, interpreted based on @tclass
+ * @ad: auxiliary audit data
+ *
+ * As cred_ssid_has_perm(), but each namespace checks the object by the SID its
+ * own policy gives it, such as a port or node label.
+ * Return %0 if all @requested permissions are granted, -%EACCES if any
+ * permissions are denied, or another -errno upon other errors.
+ */
+int cred_policy_object_has_perm(const struct cred *cred, u32 ssid,
+				object_sid_fn object_sid, const void *arg,
+				u16 tclass, u32 requested,
+				struct common_audit_data *ad)
+{
+	struct cred_security_struct *crsec = selinux_cred(cred);
+	u32 tsid;
+	int rc;
+
+	for (;;) {
+		rc = object_sid(crsec->state, arg, &tsid);
+		if (rc)
+			return rc;
+		rc = avc_has_perm(crsec->state, ssid, tsid, tclass, requested,
+				  ad);
+		if (rc)
+			return rc;
+
+		if (!crsec->parent_cred)
+			return 0;
+		crsec = selinux_cred(crsec->parent_cred);
+		ssid = crsec->sid;
+	}
+}
+
 u32 avc_policy_seqno(struct selinux_state *state)
 {
 	return state->avc->avc_cache.latest_notif;
