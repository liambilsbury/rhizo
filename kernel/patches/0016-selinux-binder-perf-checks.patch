+/**
+ * cred_peer_has_perm - Check and audit permissions on a peer task's cred
+ * @cred: subject credentials
+ * @other: the peer's credentials, the object of the check
+ * @tclass: target security class
+ * @requested: requested permissions, interpreted based on @tclass
+ * @ad: auxiliary audit data
+ *
+ * As cred_other_has_perm(), but the peer's namespace owns the object, so an
+ * ancestor of a namespace decides only the global part of an access between
+ * two of its tasks, and audits nothing for the rest.
+ * Return %0 if all @requested permissions are granted, -%EACCES if any
+ * permissions are denied, or another -errno upon other errors.
+ */
+int cred_peer_has_perm(const struct cred *cred, const struct cred *other,
+		       u16 tclass, u32 requested,
