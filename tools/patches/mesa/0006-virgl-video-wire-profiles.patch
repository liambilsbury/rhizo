+/* video profiles in virglrenderer's wire numbering */
+
+#ifndef VIRGL_VIDEO_PROFILE_H
+#define VIRGL_VIDEO_PROFILE_H
+
+#include <stdint.h>
+
+#include "pipe/p_video_enums.h"
+
+enum virgl_video_profile {
+   VIRGL_VIDEO_PROFILE_UNKNOWN = 0,
+   VIRGL_VIDEO_PROFILE_MPEG1 = 1,
+   VIRGL_VIDEO_PROFILE_MPEG2_SIMPLE = 2,
+   VIRGL_VIDEO_PROFILE_MPEG2_MAIN = 3,
+   VIRGL_VIDEO_PROFILE_MPEG4_SIMPLE = 4,
+   VIRGL_VIDEO_PROFILE_MPEG4_ADVANCED_SIMPLE = 5,
+   VIRGL_VIDEO_PROFILE_VC1_SIMPLE = 6,
+   VIRGL_VIDEO_PROFILE_VC1_MAIN = 7,
+   VIRGL_VIDEO_PROFILE_VC1_ADVANCED = 8,
+   VIRGL_VIDEO_PROFILE_MPEG4_AVC_BASELINE = 9,
+   VIRGL_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE = 10,
+   VIRGL_VIDEO_PROFILE_MPEG4_AVC_MAIN = 11,
+   VIRGL_VIDEO_PROFILE_MPEG4_AVC_EXTENDED = 12,
+   VIRGL_VIDEO_PROFILE_MPEG4_AVC_HIGH = 13,
+   VIRGL_VIDEO_PROFILE_MPEG4_AVC_HIGH10 = 14,
+   VIRGL_VIDEO_PROFILE_MPEG4_AVC_HIGH422 = 15,
+   VIRGL_VIDEO_PROFILE_MPEG4_AVC_HIGH444 = 16,
+   VIRGL_VIDEO_PROFILE_HEVC_MAIN = 17,
+   VIRGL_VIDEO_PROFILE_HEVC_MAIN_10 = 18,
+   VIRGL_VIDEO_PROFILE_HEVC_MAIN_STILL = 19,
+   VIRGL_VIDEO_PROFILE_HEVC_MAIN_12 = 20,
+   VIRGL_VIDEO_PROFILE_HEVC_MAIN_444 = 21,
+   VIRGL_VIDEO_PROFILE_JPEG_BASELINE = 22,
+   VIRGL_VIDEO_PROFILE_VP9_PROFILE0 = 23,
+   VIRGL_VIDEO_PROFILE_VP9_PROFILE2 = 24,
+   VIRGL_VIDEO_PROFILE_AV1_MAIN = 25,
+};
+
+#define VIRGL_VIDEO_WIRE_PROFILES(X) \
+   X(MPEG1) X(MPEG2_SIMPLE) X(MPEG2_MAIN) X(MPEG4_SIMPLE) X(MPEG4_ADVANCED_SIMPLE) \
+   X(VC1_SIMPLE) X(VC1_MAIN) X(VC1_ADVANCED) \
+   X(MPEG4_AVC_BASELINE) X(MPEG4_AVC_CONSTRAINED_BASELINE) X(MPEG4_AVC_MAIN) \
+   X(MPEG4_AVC_EXTENDED) X(MPEG4_AVC_HIGH) X(MPEG4_AVC_HIGH10) X(MPEG4_AVC_HIGH422) \
+   X(MPEG4_AVC_HIGH444) \
+   X(HEVC_MAIN) X(HEVC_MAIN_10) X(HEVC_MAIN_STILL) X(HEVC_MAIN_12) X(HEVC_MAIN_444) \
+   X(JPEG_BASELINE) X(VP9_PROFILE0) X(VP9_PROFILE2) X(AV1_MAIN)
+
+/* map a Mesa profile to its wire number */
+static inline enum virgl_video_profile
+virgl_video_profile_to_wire(enum pipe_video_profile profile)
+{
+   switch (profile) {
+#define VIRGL_VIDEO_TO_WIRE(name) \
+   case PIPE_VIDEO_PROFILE_##name: return VIRGL_VIDEO_PROFILE_##name;
+   VIRGL_VIDEO_WIRE_PROFILES(VIRGL_VIDEO_TO_WIRE)
+#undef VIRGL_VIDEO_TO_WIRE
+   default:
+      return VIRGL_VIDEO_PROFILE_UNKNOWN;
+   }
+}
+
+/* map a wire number to its Mesa profile */
+static inline enum pipe_video_profile
+virgl_video_profile_from_wire(uint32_t wire)
+{
+   switch (wire) {
+#define VIRGL_VIDEO_FROM_WIRE(name) \
+   case VIRGL_VIDEO_PROFILE_##name: return PIPE_VIDEO_PROFILE_##name;
+   VIRGL_VIDEO_WIRE_PROFILES(VIRGL_VIDEO_FROM_WIRE)
+#undef VIRGL_VIDEO_FROM_WIRE
+   default:
+      return PIPE_VIDEO_PROFILE_UNKNOWN;
+   }
+}
+
+#endif /* VIRGL_VIDEO_PROFILE_H */
