+/* return the MatrixCoefficients code of a colour standard */
+static unsigned
+vlVaMatrixCoefficients(VAProcColorStandardType standard,
+                       const VAProcColorProperties *props)
+{
+   switch (standard) {
+   case VAProcColorStandardBT709:
+   case VAProcColorStandardGenericFilm:
+   case VAProcColorStandardXVYCC709:
+      return 1;
+   case VAProcColorStandardBT470M:
+      return 4;
+   case VAProcColorStandardBT470BG:
+   case VAProcColorStandardXVYCC601:
+      return 5;
+   case VAProcColorStandardBT601:
+   case VAProcColorStandardSMPTE170M:
+      return 6;
+   case VAProcColorStandardSMPTE240M:
+      return 7;
+   case VAProcColorStandardBT2020:
+      return 9;
+   case VAProcColorStandardExplicit:
+      return props->matrix_coefficients;
+   default:
+      return 0;
+   }
+}
+
+/* return the luma weights of a MatrixCoefficients code */
+static bool
+vlVaLumaWeights(unsigned mc, double *kr, double *kb)
+{
+   switch (mc) {
+   case 1: /* Rec. ITU-R BT.709-6 */
+      *kr = 0.2126;
+      *kb = 0.0722;
+      return true;
+   case 4: /* US FCC Title 47 CFR 73.682 (a)(20) */
+      *kr = 0.30;
+      *kb = 0.11;
+      return true;
+   case 5: /* Rec. ITU-R BT.470-6 System B, G; BT.601-7 625 */
+   case 6: /* Rec. ITU-R BT.601-7 525; SMPTE ST 170 */
+      *kr = 0.299;
+      *kb = 0.114;
+      return true;
+   case 7: /* SMPTE ST 240 */
+      *kr = 0.212;
+      *kb = 0.087;
+      return true;
+   case 9: /* Rec. ITU-R BT.2020-2 non-constant luminance; BT.2100 Y'CbCr */
+      *kr = 0.2627;
+      *kb = 0.0593;
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* return a Y'CbCr format's sample and container bits */
+static void
+vlVaSampleBits(enum pipe_format format, unsigned *bits, unsigned *container_bits)
+{
+   switch (format) {
+   case PIPE_FORMAT_P010:
+      *bits = 10;
+      *container_bits = 16;
+      break;
+   case PIPE_FORMAT_P012:
+      *bits = 12;
+      *container_bits = 16;
+      break;
+   case PIPE_FORMAT_P016:
+      *bits = 16;
+      *container_bits = 16;
+      break;
+   default:
+      *bits = 8;
+      *container_bits = 8;
+      break;
+   }
+}
