+/* compute a sample's texel and full-scale codes in 8-bit units */
+static void
+vl_csc_sample_scale(unsigned bits, unsigned container_bits, double *texel, double *full)
+{
+   assert(bits >= 8 && bits <= container_bits && container_bits <= 16);
+   *texel = (double)((1u << container_bits) - 1) / (double)(1u << (container_bits - 8));
+   *full = (double)((1u << bits) - 1) / (double)(1u << (bits - 8));
+}
+
+void vl_csc_get_ycbcr_to_rgb_matrix(double kr, double kb,
+                                    unsigned bits, unsigned container_bits,
+                                    bool ycbcr_full_range, bool rgb_full_range,
+                                    vl_csc_matrix *matrix)
+{
+   const double kg = 1.0 - kr - kb;
+   double q, f;
+
+   vl_csc_sample_scale(bits, container_bits, &q, &f);
+
+   const double ydiv = ycbcr_full_range ? f : 219.0;
+   const double yoff = ycbcr_full_range ? 0.0 : 16.0;
+   const double cdiv = ycbcr_full_range ? f : 224.0;
+   const double os = rgb_full_range ? 1.0 : 219.0 / 255.0;
+   const double oo = rgb_full_range ? 0.0 : 16.0 / 255.0;
+   const double pb[3] = { 0.0, -2.0 * (1.0 - kb) * kb / kg, 2.0 * (1.0 - kb) };
+   const double pr[3] = { 2.0 * (1.0 - kr), -2.0 * (1.0 - kr) * kr / kg, 0.0 };
+
+   assert(matrix);
+
+   for (unsigned i = 0; i < 3; i++) {
+      (*matrix)[i][0] = os * q / ydiv;
+      (*matrix)[i][1] = os * q / cdiv * pb[i];
+      (*matrix)[i][2] = os * q / cdiv * pr[i];
+      (*matrix)[i][3] = oo - os * (yoff / ydiv + 128.0 / cdiv * (pb[i] + pr[i]));
+   }
+}
+
+void vl_csc_get_rgb_to_ycbcr_matrix(double kr, double kb,
+                                    bool rgb_full_range,
+                                    unsigned bits, unsigned container_bits,
+                                    bool ycbcr_full_range,
+                                    vl_csc_matrix *matrix)
+{
+   const double kg = 1.0 - kr - kb;
+   double q, f;
+
+   vl_csc_sample_scale(bits, container_bits, &q, &f);
+
+   const double is = rgb_full_range ? 1.0 : 255.0 / 219.0;
+   const double io = rgb_full_range ? 0.0 : 16.0 / 255.0;
+   const double ydiv = ycbcr_full_range ? f : 219.0;
+   const double yoff = ycbcr_full_range ? 0.0 : 16.0;
+   const double cdiv = ycbcr_full_range ? f : 224.0;
+   const double w[3][3] = {
+      { kr, kg, kb },
+      { -0.5 * kr / (1.0 - kb), -0.5 * kg / (1.0 - kb), 0.5 },
+      { 0.5, -0.5 * kg / (1.0 - kr), -0.5 * kb / (1.0 - kr) },
+   };
+   const double scale[3] = { ydiv / q, cdiv / q, cdiv / q };
+   const double offset[3] = { yoff / q, 128.0 / q, 128.0 / q };
+
+   assert(matrix);
+
+   for (unsigned i = 0; i < 3; i++) {
+      (*matrix)[i][0] = scale[i] * is * w[i][0];
+      (*matrix)[i][1] = scale[i] * is * w[i][1];
+      (*matrix)[i][2] = scale[i] * is * w[i][2];
+      (*matrix)[i][3] = offset[i] - scale[i] * is * io * (w[i][0] + w[i][1] + w[i][2]);
+   }
+}
