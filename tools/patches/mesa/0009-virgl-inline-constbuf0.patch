+/* send the buffer bound at constant slot 0 inline */
+static void virgl_emit_inline_ubo0(struct virgl_context *vctx,
+                                   enum pipe_shader_type shader)
+{
+   const struct pipe_constant_buffer *cb = &vctx->shader_bindings[shader].inline_ubo0;
+   struct pipe_transfer *transfer = NULL;
+   const void *data;
+   unsigned size;
+
+   if (!cb->buffer)
+      return;
+   size = MIN2(cb->buffer_size, 4096 * 16);
+   data = pipe_buffer_map_range(&vctx->base, cb->buffer, cb->buffer_offset, size,
+                                PIPE_MAP_READ | PIPE_MAP_UNSYNCHRONIZED, &transfer);
+   if (!data)
+      return;
+   virgl_encoder_write_constant_buffer(vctx, shader, 0, size / 4, data);
+   pipe_buffer_unmap(&vctx->base, transfer);
+}
