+/* set each plane's clamp half a texel inside the source */
+static void
+calc_plane_clamp(struct vl_compositor_layer *layer)
+{
+   for (unsigned p = 0; p < 2; ++p) {
+      struct pipe_sampler_view *view = layer->sampler_views[p];
+      float hx = 0.0f, hy = 0.0f;
+      float x0, y0, x1, y1;
+
+      if (view && view->texture->width0 && view->texture->height0) {
+         hx = 0.5f / view->texture->width0;
+         hy = 0.5f / view->texture->height0;
+      }
+      x0 = layer->src.tl.x + hx;
+      x1 = layer->src.br.x - hx;
+      y0 = layer->src.tl.y + hy;
+      y1 = layer->src.br.y - hy;
+      if (x0 > x1)
+         x0 = x1 = (layer->src.tl.x + layer->src.br.x) * 0.5f;
+      if (y0 > y1)
+         y0 = y1 = (layer->src.tl.y + layer->src.br.y) * 0.5f;
+      layer->plane_clamp[p][0] = x0;
+      layer->plane_clamp[p][1] = y0;
+      layer->plane_clamp[p][2] = x1;
+      layer->plane_clamp[p][3] = y1;
+   }
+}
+
+static void
+clear_plane_clamp(struct vl_compositor_layer *layer)
+{
+   for (unsigned p = 0; p < 2; ++p) {
+      layer->plane_clamp[p][0] = layer->plane_clamp[p][1] = 0.0f;
+      layer->plane_clamp[p][2] = layer->plane_clamp[p][3] = 1.0f;
+   }
+}
+
