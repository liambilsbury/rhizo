+constexpr size_t kRhizoMasterKeyBytes = 32;
+constexpr char kRhizoMasterKeyDir[] = "/data/rhizo_keymint";
+constexpr char kRhizoMasterKeyPath[] = "/data/rhizo_keymint/master.key";
+
+enum class RhizoKeyLoad { kLoaded, kAbsent, kUnusable };
+
+// read the persisted master key
+RhizoKeyLoad RhizoLoadMasterKey(uint8_t* out) {
+    int fd = TEMP_FAILURE_RETRY(open(kRhizoMasterKeyPath, O_RDONLY | O_CLOEXEC));
+    if (fd < 0) {
+        if (errno == ENOENT) return RhizoKeyLoad::kAbsent;
+        LOG_E("rhizo: cannot open the KeyMint master key at %s: %s", kRhizoMasterKeyPath,
+              strerror(errno));
+        return RhizoKeyLoad::kUnusable;
+    }
+    uint8_t buf[kRhizoMasterKeyBytes + 1];
+    ssize_t n = TEMP_FAILURE_RETRY(read(fd, buf, sizeof(buf)));
+    int read_errno = errno;
+    close(fd);
+    if (n < 0) {
+        LOG_E("rhizo: cannot read the KeyMint master key at %s: %s", kRhizoMasterKeyPath,
+              strerror(read_errno));
+        return RhizoKeyLoad::kUnusable;
+    }
+    if (static_cast<size_t>(n) != kRhizoMasterKeyBytes) {
+        LOG_E("rhizo: the KeyMint master key at %s is %zd bytes, expected %zu -- refusing to "
+              "replace it, because every AES key blob on this /data was wrapped with the key "
+              "it should hold and overwriting it would destroy them for good",
+              kRhizoMasterKeyPath, n, kRhizoMasterKeyBytes);
+        return RhizoKeyLoad::kUnusable;
+    }
+    memcpy(out, buf, kRhizoMasterKeyBytes);
+    return RhizoKeyLoad::kLoaded;
+}
+
+// write the master key file and fsync it
+bool RhizoPersistMasterKey(const uint8_t* key) {
+    int fd = TEMP_FAILURE_RETRY(
+        open(kRhizoMasterKeyPath, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600));
+    if (fd < 0) {
+        LOG_E("rhizo: cannot create the KeyMint master key at %s: %s", kRhizoMasterKeyPath,
+              strerror(errno));
+        return false;
+    }
+    size_t written = 0;
+    while (written < kRhizoMasterKeyBytes) {
+        ssize_t n = TEMP_FAILURE_RETRY(write(fd, key + written, kRhizoMasterKeyBytes - written));
+        if (n <= 0) {
+            LOG_E("rhizo: cannot write the KeyMint master key at %s: %s", kRhizoMasterKeyPath,
+                  strerror(errno));
+            close(fd);
+            unlink(kRhizoMasterKeyPath);
+            return false;
+        }
+        written += static_cast<size_t>(n);
+    }
+    bool durable = (fsync(fd) == 0);
+    if (!durable) {
+        LOG_E("rhizo: cannot fsync the KeyMint master key at %s: %s", kRhizoMasterKeyPath,
+              strerror(errno));
+    }
+    close(fd);
+    if (!durable) {
+        unlink(kRhizoMasterKeyPath);
+        return false;
+    }
+    int dfd = TEMP_FAILURE_RETRY(open(kRhizoMasterKeyDir, O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+    if (dfd >= 0) {
+        fsync(dfd);
+        close(dfd);
+    }
+    LOG_I("rhizo: created and persisted a new KeyMint master key at %s", kRhizoMasterKeyPath);
+    return true;
+}
