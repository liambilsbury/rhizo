+}  // namespace
+
+// return the master key, loading or creating it
+static const KeymasterKeyBlob& RhizoAesGcmMasterKey() {
+    static std::mutex mu;
+    static KeymasterKeyBlob* blob = nullptr;
+    static bool persisted = false;
+    static int persist_attempts = 0;
+    static bool warned_unpersisted = false;
+    constexpr int kMaxPersistAttempts = 8;
+
+    std::lock_guard<std::mutex> lock(mu);
+
+    if (blob == nullptr) {
+        blob = new KeymasterKeyBlob(kRhizoMasterKeyBytes);
+        switch (RhizoLoadMasterKey(blob->writable_data())) {
+        case RhizoKeyLoad::kLoaded:
+            persisted = true;
+            break;
+        case RhizoKeyLoad::kAbsent:
+            RAND_bytes(blob->writable_data(), kRhizoMasterKeyBytes);
+            ++persist_attempts;
+            persisted = RhizoPersistMasterKey(blob->key_material);
+            break;
+        case RhizoKeyLoad::kUnusable:
+            RAND_bytes(blob->writable_data(), kRhizoMasterKeyBytes);
+            persist_attempts = kMaxPersistAttempts;
+            break;
+        }
+    } else if (!persisted && persist_attempts < kMaxPersistAttempts) {
+        ++persist_attempts;
+        if (RhizoLoadMasterKey(blob->writable_data()) == RhizoKeyLoad::kLoaded) {
+            persisted = true;
+        } else {
+            persisted = RhizoPersistMasterKey(blob->key_material);
+        }
+    }
+
+    if (!persisted && !warned_unpersisted) {
+        warned_unpersisted = true;
+        LOG_E("rhizo: SERVING A KEYMINT MASTER KEY THAT IS NOT ON DISK. Every AES key blob "
+              "created in this process stops being decryptable when it exits. The errors "
+              "above say why %s could not be written.",
+              kRhizoMasterKeyPath);
+    }
+    return *blob;
+}
+
+// parse a blob encrypted with the master key
+static keymaster_error_t ParseRhizoEncryptedBlob(const KeymasterKeyBlob& blob,
+                                                 const AuthorizationSet& hidden,
+                                                 KeymasterKeyBlob* key_material,
+                                                 AuthorizationSet* hw_enforced,
+                                                 AuthorizationSet* sw_enforced) {
+    KmErrorOr<DeserializedKey> key = DeserializeAuthEncryptedBlob(blob);
+    if (!key) return key.error();
+
+    KmErrorOr<KeymasterKeyBlob> decrypted =
+        DecryptKey(*key, hidden, SecureDeletionData(), RhizoAesGcmMasterKey());
+    if (!decrypted) return decrypted.error();
+
+    *key_material = std::move(*decrypted);
+    *hw_enforced = std::move(key->hw_enforced);
+    *sw_enforced = std::move(key->sw_enforced);
+    return KM_ERROR_OK;
+}
