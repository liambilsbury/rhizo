+// check the token mac against hmac_key_
+bool SoftKeymasterEnforcement::ValidateTokenSignature(const hw_auth_token_t& token) const {
+    keymaster_blob_t data = {reinterpret_cast<const uint8_t*>(&token),
+                             offsetof(hw_auth_token_t, hmac)};
+    keymaster_blob_t data_chunks[] = {data};
+    KeymasterBlob computed;
+    if (hmacSha256(hmac_key_, data_chunks, 1, &computed) != KM_ERROR_OK) return false;
+    if (computed.data_length != sizeof(token.hmac)) return false;
+    return CRYPTO_memcmp(computed.data, token.hmac, sizeof(token.hmac)) == 0;
+}
+
+// check the token age against the timeout
+bool SoftKeymasterEnforcement::auth_token_timed_out(const hw_auth_token_t& token,
+                                                    uint32_t timeout) const {
+    uint64_t token_time_ms = ntoh(token.timestamp);
+    uint64_t now_ms = get_current_time_ms();
+    uint64_t timeout_ms = static_cast<uint64_t>(timeout) * 1000;
+    if (now_ms < token_time_ms) return false;
+    return (now_ms - token_time_ms) > timeout_ms;
+}
